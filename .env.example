# Copy this file to .env.local and fill in the values.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Sanity (blog). From sanity.io/manage > your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Paystack (donations). From dashboard.paystack.com > Settings > API Keys & Webhooks.
# Use the sk_test_ key while testing, then swap to sk_live_ when you go live.
PAYSTACK_SECRET_KEY=
